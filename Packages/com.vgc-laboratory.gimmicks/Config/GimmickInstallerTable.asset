    - language: ChineseTraditional
      text: "\u8DE8\u5E73\u53F0/Cross-Platform"
  - id: UseCrossPlatformPrefab
    values:
    - language: Japanese
      text: "\u30AF\u30ED\u30B9\u30D7\u30E9\u30C3\u30C8\u30D5\u30A9\u30FC\u30E0Prefab\u3092\u4F7F\u7528"
    - language: English
